# Copy to .env.local (gitignored) and fill in. Vite reads it for `npm run dev` and `npm run build`;
# on a host like Vercel or Netlify, set the same variables in its build settings instead.

# Your Supabase project's URL and publishable key, from Project Settings > API Keys. The publishable
# key is safe in the browser: the game only reaches the three functions the migration grants it.
# A project's legacy anon key works here too. Leave them out to play offline.
VITE_SUPABASE_URL=https://<project ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Where the game's deployed, with no trailing slash, for the picture a shared link shows.
VITE_SITE_URL=https://heads-up.example.com
